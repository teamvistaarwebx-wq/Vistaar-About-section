---
/**
 * Case studies snapshot (after How we work), laid out like the printed case-study spreads.
 *
 * One spread per slide (with the next one peeking on phones), prev/next buttons and an "n / 4"
 * counter. Left: logo + sector, a headline and the challenge → work → result story with red arrows.
 * Right: a minimal before/after bar chart (grey before, brand red after, on a labelled axis with
 * gridlines), the headline figure, and the source note.
 *
 * Charts show only the reported numbers. A bar with `upto` adds a lighter band for the top of a
 * range (Jam2gather's 10–14×). When a spread comes into view the gridlines draw, the bars rise one
 * after another, the values land and the headline figure counts up; it replays on re-entry.
 * Every bar is direct-labelled with a hover/focus tooltip, and each chart has a hidden data table.
 */
import { caseStudies } from '../../data/about.js';

/** Wrap each number in a count-up span; the spread counts them up when it comes into view. */
const countUp = (text: string) =>
  text.replace(/\d+(?:\.\d+)?/g, (n) => `<span class="cs__count" data-cs-count="${n}">${n}</span>`);
const total = caseStudies.items.length;

type Bar = { label: string; value: number; upto?: number; prefix?: string };
type Chart = { max: number; step: number; decimals: number; format: string; bars: Bar[] };
const show = (ch: Chart, v: number) => ch.format.replace('{v}', String(v));
const barValue = (ch: Chart, b: Bar) =>
  b.upto ? ch.format.replace('{v}', `${b.value}–${b.upto}`) : `${b.prefix ?? ''}${show(ch, b.value)}`;
const ticks = (ch: Chart) => {
  const out: string[] = [];
  for (let k = 0; k * ch.step <= ch.max + 1e-9; k++) out.push((k * ch.step).toFixed(ch.decimals));
  return out;
};
const pct = (v: number, max: number) => `${((v / max) * 100).toFixed(2)}%`;
---

<section class="section cs" aria-labelledby="cs-title" data-cs>
  <div class="container">
    <header class="cs__head">
      <div class="cs__head-text">
        <p class="eyebrow">
          {caseStudies.eyebrow}<span class="cs__counter" aria-hidden="true">
            · <span data-cs-current>1</span> / {total}</span
          >
        </p>
        <h2 class="section-title" id="cs-title">
          {caseStudies.title.replace(/\.$/, '')}<span class="accent">.</span>
        </h2>
        <p class="cs__intro">{caseStudies.intro}</p>
      </div>
      <div class="cs__nav">
        <button class="cs__btn" type="button" data-cs-prev aria-label="Previous case study" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
        </button>
        <button class="cs__btn" type="button" data-cs-next aria-label="Next case study">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
        </button>
      </div>
    </header>
  </div>

  <div class="container cs__viewport">
    <ul class="cs__track" data-cs-track tabindex="0" aria-label="Case studies, scroll sideways for more">
      {
        caseStudies.items.map((c, i) => {
          const ch = c.chart;
          return (
            <li class="cs__card" data-cs-card={i}>
              <article class="cs__inner" aria-labelledby={`cs-client-${i}`}>
                <div class="cs__story">
                  <div class="cs__top">
                    <h3 class="cs__client" id={`cs-client-${i}`}>
                      {c.logo ? (
                        <img
                          class="cs__logo"
                          src={c.logo.src}
                          alt={c.client}
                          width={c.logo.width}
                          height={c.logo.height}
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <span class="cs__wordmark">{c.client}</span>
                      )}
                    </h3>
                    <span class="cs__sector">{c.sector}</span>
                  </div>

                  <p class="cs__headline">{c.headline}</p>

                  <ol class="cs__steps">
                    {[
                      ['The challenge', c.challenge],
                      ['What we did', c.work],
                      ['The result', c.result],
                    ].map(([label, text]) => (
                      <li class="cs__step">
                        <h4 class="cs__label">{label}</h4>
                        <p>{text}</p>
                      </li>
                    ))}
                  </ol>

                  <ul class="cs__tags" aria-label="Services">
                    {c.tags.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                </div>

                <div class="cs__visual">
                  <figure class="cs__chart">
                    <figcaption class="cs__chart-cap">
                      <span class="cs__chart-client">{c.client}</span> · {c.chart.caption}
                    </figcaption>
                    <p class="cs__axis" aria-hidden="true">{c.chart.axis}</p>
                    <div class="cs__plot">
                      <ol class="cs__ticks" aria-hidden="true">
                        {ticks(c.chart).map((t, k) => (
                          <li style={`bottom: ${pct(Number(t), c.chart.max)}; --k: ${k}`}>
                            <span>{t}</span>
                          </li>
                        ))}
                      </ol>
                      <div class="cs__bars">
                        {c.chart.bars.map((bar, k) => {
                          const top = bar.upto ?? bar.value;
                          const tip = `${bar.label}: ${barValue(c.chart, bar)}`;
                          return (
                            <div class={`cs__col cs__col--${k === 0 ? 'base' : 'focus'}`} style={`--k: ${k}`}>
                              <span
                                class="cs__bar"
                                style={`height: ${pct(top, c.chart.max)}; --solid: ${((bar.value / top) * 100).toFixed(2)}%`}
                                tabindex="0"
                                data-tip={tip}
                                aria-label={tip}
                              >
                                <span class="cs__bar-val" aria-hidden="true">{barValue(c.chart, bar)}</span>
                              </span>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                    <div class="cs__xlabels" aria-hidden="true">
                      {c.chart.bars.map((bar) => (
                        <span>{bar.label}</span>
                      ))}
                    </div>
                    <table class="visually-hidden">
                      <tr><th scope="col">{c.chart.axis}</th><th scope="col">Value</th></tr>
                      {c.chart.bars.map((bar) => (
                        <tr><td>{bar.label}</td><td>{barValue(c.chart, bar)}</td></tr>
                      ))}
                    </table>
                  </figure>

                  <div class="cs__outcome">
                    {c.phases?.map((ph) => (
                      <div class="cs__phase">
                        <p class="cs__phase-label">{ph.label}</p>
                        <p class="cs__phase-text">{ph.text}</p>
                      </div>
                    ))}
                    {c.phases && <span class="cs__phase-link" aria-hidden="true" />}
                    <div class:list={['cs__stat', { 'cs__stat--dark': c.phases }]}>
                      {c.stat.kicker && <p class="cs__phase-label">{c.stat.kicker}</p>}
                      {c.stat.prefix && <p class="cs__stat-prefix">{c.stat.prefix}</p>}
                      <p class="cs__stat-value">
                        <Fragment set:html={countUp(c.stat.value)} />
                        {c.stat.unit && <span class="cs__stat-unit">{c.stat.unit}</span>}
                      </p>
                      {c.stat.label && <p class="cs__stat-label">{c.stat.label}</p>}
                      {c.stat.lines?.map((l) => (
                        <p class="cs__stat-line">{l}</p>
                      ))}
                    </div>
                  </div>

                  {c.note && <p class="cs__note">{c.note}</p>}
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-cs]').forEach((section) => {
    const track = section.querySelector<HTMLElement>('[data-cs-track]')!;
    const cards = [...section.querySelectorAll<HTMLElement>('[data-cs-card]')];
    const prev = section.querySelector<HTMLButtonElement>('[data-cs-prev]')!;
    const next = section.querySelector<HTMLButtonElement>('[data-cs-next]')!;
    const current = section.querySelector<HTMLElement>('[data-cs-current]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    function countUp(card: Element) {
      card.querySelectorAll<HTMLElement>('[data-cs-count]').forEach((el) => {
        const raw = el.dataset.csCount ?? '0';
        const target = Number(raw);
        const dp = (raw.split('.')[1] ?? '').length;
        const start = performance.now() + 450; // starts as the figure fades in
        el.textContent = (0).toFixed(dp);
        const tick = (now: number) => {
          const t = Math.min(1, Math.max(0, (now - start) / 1200));
          el.textContent = (target * (1 - Math.pow(1 - t, 3))).toFixed(dp);
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }

    // Charts animate and figures count up each time a spread comes into view (replays after it leaves).
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting && e.intersectionRatio >= 0.3) {
            if (e.target.classList.contains('is-in')) return;
            e.target.classList.add('is-in');
            countUp(e.target);
          } else if (!e.isIntersecting) {
            e.target.classList.remove('is-in');
          }
        }),
      { threshold: [0, 0.3] },
    );
    if (reduce.matches || !('IntersectionObserver' in window)) cards.forEach((c) => c.classList.add('is-in'));
    else cards.forEach((c) => io.observe(c));
    section.classList.add('is-enhanced');

    const step = () => (cards[1] ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth);

    function sync() {
      const i = Math.round(track.scrollLeft / step());
      if (current) current.textContent = String(Math.min(cards.length, i + 1));
      prev.disabled = track.scrollLeft <= 4;
      next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
    }

    const go = (dir: number) =>
      track.scrollBy({ left: dir * step(), behavior: reduce.matches ? 'auto' : 'smooth' });
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    window.addEventListener('resize', sync);
    sync();
  });
</script>

<style>
  .cs {
    --cs-muted-mark: color-mix(in srgb, var(--color-ink) 36%, var(--color-bg));
    --cs-band: rgb(var(--color-brand-rgb) / 0.35);
    overflow: clip;
  }

  /* ---------- Header ---------- */
  .cs__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: clamp(var(--space-6), 3vw, var(--space-7));
  }

  .cs__head-text {
    display: grid;
    gap: var(--space-4);
  }

  .cs__counter {
    margin-left: 0.35em;
    font-variant-numeric: tabular-nums;
  }

  .cs__intro {
    max-width: 38rem;
    font-size: var(--fs-lead);
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }

  .cs__nav {
    display: flex;
    gap: var(--space-2);
  }

  .cs__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out);
  }

  .cs__btn svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cs__btn:not(:disabled):hover {
    background: var(--color-ink);
    color: var(--color-on-brand);
  }

  .cs__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* ---------- Track ---------- */
  .cs__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(92%, 640px);
    gap: var(--space-4);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    align-items: start;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: var(--space-2);
  }

  .cs__track::-webkit-scrollbar {
    display: none;
  }

  .cs__track:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 4px;
    border-radius: var(--radius-card);
  }

  @media (min-width: 900px) {
    .cs__track {
      grid-auto-columns: 100%;
      gap: var(--space-5);
    }
  }

  /* ---------- Spread ---------- */
  .cs__card {
    position: relative; /* contains the visually hidden data tables */
    scroll-snap-align: start;
    display: flex;
  }

  .cs__inner {
    display: grid;
    gap: clamp(var(--space-6), 4vw, 64px);
    width: 100%;
    padding: clamp(var(--space-5), 3vw, 48px);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-bg);
  }

  @media (min-width: 1024px) {
    .cs__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
  }

  /* ---------- Story column ---------- */
  .cs__story {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .cs__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 52px;
  }

  .cs__client {
    margin: 0;
    line-height: 0;
  }

  .cs__logo {
    width: auto;
    max-width: 150px;
    max-height: 52px;
  }

  .cs__wordmark {
    font-size: 1.375rem;
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .cs__sector {
    flex: none;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }

  .cs__headline {
    max-width: 18ch;
    font-size: clamp(1.625rem, 1.15rem + 1.7vw, 2.625rem);
    font-weight: var(--fw-bold);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--color-ink);
  }

  /* Challenge ↓ work ↓ result */
  .cs__steps {
    display: grid;
  }

  .cs__step {
    display: grid;
    gap: var(--space-1);
  }

  .cs__step + .cs__step::before {
    content: '';
    display: block;
    width: 12px;
    height: 26px;
    margin: var(--space-2) 0;
    background: var(--color-brand);
    /* a thin down arrow */
    clip-path: polygon(5.25px 0, 6.75px 0, 6.75px 19px, 12px 15px, 12px 17px, 6px 26px, 0 17px, 0 15px, 5.25px 19px);
  }

  .cs__label {
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-brand);
  }

  .cs__step p {
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--color-text);
  }

  .cs__step:last-child p {
    font-weight: var(--fw-semibold);
    color: var(--color-ink);
  }

  .cs__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .cs__tags li {
    padding: 5px 12px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }

  /* ---------- Visual column ---------- */
  .cs__visual {
    --cs-axis-w: 2.5rem;
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  @media (min-width: 1200px) {
    .cs__visual {
      grid-template-columns: minmax(0, 1fr) 16rem;
      align-items: center;
    }

    .cs__note {
      grid-column: 1 / -1;
    }
  }

  .cs__chart {
    margin: 0;
    padding: clamp(var(--space-4), 2vw, 28px);
    border: 1px solid var(--color-line);
    border-radius: 18px;
    background: var(--color-bg);
  }

  .cs__chart-cap {
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--color-text);
  }

  .cs__chart-client {
    font-weight: var(--fw-bold);
    color: var(--color-ink);
  }

  .cs__axis {
    margin-top: var(--space-4);
    font-size: 0.6875rem;
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .cs__plot {
    position: relative;
    height: clamp(190px, 20vw, 270px);
    margin-top: var(--space-6); /* room for the tallest bar's value */
  }

  .cs__ticks li {
    position: absolute;
    left: 0;
    right: 0;
    height: 0;
  }

  .cs__ticks li::before {
    content: '';
    position: absolute;
    left: var(--cs-axis-w);
    right: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 7%, transparent);
    transform-origin: left;
  }

  .cs__ticks li:first-child::before {
    border-top-color: color-mix(in srgb, var(--color-ink) 35%, transparent);
  }

  .cs__ticks span {
    position: absolute;
    left: 0;
    font-size: 0.6875rem;
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--color-text-muted);
    transform: translateY(-50%);
  }

  .cs__bars {
    position: absolute;
    inset: 0 0 0 var(--cs-axis-w);
    display: flex;
  }

  .cs__col {
    flex: 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    --bar: var(--cs-muted-mark);
    --band: var(--cs-muted-mark);
  }

  .cs__col--focus {
    --bar: var(--color-brand);
    --band: var(--cs-band);
  }

  .cs__bar {
    position: relative;
    display: block;
    width: min(56%, 132px);
    min-height: 3px;
    border-radius: 3px 3px 0 0;
    background: linear-gradient(to top, var(--bar) var(--solid), var(--band) var(--solid));
    transform-origin: bottom;
  }

  .cs__bar-val {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    font-size: var(--fs-body);
    font-weight: var(--fw-bold);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-ink);
    transform: translateX(-50%);
  }

  .cs__xlabels {
    display: flex;
    margin-top: var(--space-2);
    padding-left: var(--cs-axis-w);
  }

  .cs__xlabels span {
    flex: 1;
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    text-align: center;
    color: var(--color-text);
  }

  /* Headline figure (and Mommy's month 01 → month 02 cards) */
  .cs__outcome {
    container-type: inline-size;
    min-width: 0;
    display: grid;
    gap: 0;
    align-content: center;
  }

  .cs__phase {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: 18px;
  }

  .cs__phase-label {
    font-size: 0.75rem;
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .cs__phase-text {
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--color-text);
  }

  .cs__phase-link {
    justify-self: center;
    width: 1.5px;
    height: 28px;
    background: var(--color-brand);
    transform-origin: top;
  }

  .cs__stat {
    display: grid;
    gap: var(--space-1);
  }

  .cs__stat-value {
    font-size: min(clamp(3rem, 2.2rem + 3vw, 4.25rem), 26cqi);
    font-weight: var(--fw-bold);
    line-height: 1;
    letter-spacing: -0.035em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-brand);
  }

  .cs__stat-prefix {
    font-size: var(--fs-body);
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-brand);
  }

  .cs__stat-unit {
    margin-left: 0.25em;
    font-size: 0.5em;
    letter-spacing: -0.01em;
  }

  .cs__stat-label {
    margin-top: var(--space-2);
    font-size: var(--fs-body);
    font-weight: var(--fw-bold);
    color: var(--color-ink);
  }

  .cs__stat-line {
    font-size: var(--fs-body);
    color: var(--color-text);
  }

  .cs__stat--dark {
    gap: var(--space-2);
    padding: var(--space-5);
    border-radius: 18px;
    background: var(--color-ink);
  }

  .cs__stat--dark .cs__phase-label {
    color: rgb(255 255 255 / 0.8);
  }

  .cs__stat--dark .cs__stat-value {
    font-size: min(clamp(2.25rem, 1.8rem + 1.6vw, 3rem), 22cqi);
    color: var(--color-on-brand);
  }

  .cs__stat--dark .cs__stat-line {
    font-weight: var(--fw-semibold);
    color: color-mix(in srgb, var(--color-brand) 50%, white);
  }

  .cs__note {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  /* ---------- Tooltip on bars ---------- */
  [data-tip] {
    outline: none;
  }

  [data-tip]::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 36px);
    left: 50%;
    z-index: 3;
    padding: 5px 9px;
    border-radius: 6px;
    background: var(--color-ink);
    color: var(--color-on-brand);
    font-size: 0.75rem;
    font-weight: var(--fw-semibold);
    white-space: nowrap;
    opacity: 0;
    transform: translate(-50%, 4px);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
    pointer-events: none;
  }

  [data-tip]:hover::after,
  [data-tip]:focus-visible::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  [data-tip]:focus-visible {
    box-shadow: 0 0 0 2px var(--color-bg), 0 0 0 4px var(--color-ink);
