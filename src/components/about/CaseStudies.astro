---
/**
 * Case studies snapshot (after How we work).
 *
 * A swipeable row of cards (two visible on desktop, one on phones) with prev/next buttons and an
 * "n / 3" counter. Each card: logo + sector, the challenge, what we did, tags, a small chart of the
 * reported result, and a black result bar.
 *
 * Charts show only the numbers the case study reports (no invented in-between data):
 * - growth: before → after columns (emphasis: grey before, brand red after) with a ×N connector
 * - growth: a two-point line (before → after) with an area wash and a +N% badge
 * - roas:   unit blocks, one per ₹1 returned against one ₹1 spend block; a [min, max] range
 *           adds lighter blocks up to the maximum
 * Marks grow from the baseline when the card scrolls into view; the result figures count up.
 * Every mark is direct-labelled and each chart has a visually hidden data table.
 */
import { caseStudies } from '../../data/about.js';

const fmt = (unit = '', v: number, suffix = '') => `${unit}${v}${suffix}`;
/** Wrap each number in a count-up span; the card counts them up when it comes into view. */
const countUp = (text: string) =>
  text.replace(/\d+/g, (n) => `<span class="cs__count" data-cs-count="${n}">${n}</span>`);
const total = caseStudies.items.length;

/** Growth line chart geometry (viewBox 320 × 170): two real points joined by a straight line. */
const G = { x0: 40, x1: 284, base: 140, top: 30 };
const gy = (v: number, max: number) => G.base - (v / max) * (G.base - G.top);
/** ROAS unit chart: one block per ₹1 returned. */
const units = (ch: { range?: number[]; value?: number }) => {
  const solid = ch.range ? ch.range[0] : ch.value ?? 0;
  const extra = ch.range ? ch.range[1] - ch.range[0] : 0;
  return [...Array(solid).fill('solid'), ...Array(extra).fill('range')];
};
---

<section class="section cs" aria-labelledby="cs-title" data-cs>
  <div class="container">
    <header class="cs__head">
      <div class="cs__head-text">
        <p class="eyebrow">
          {caseStudies.eyebrow}<span class="cs__counter" aria-hidden="true">
            · <span data-cs-current>1</span> / {total}</span
          >
        </p>
        <h2 class="section-title" id="cs-title">
          {caseStudies.title.replace(/\.$/, '')}<span class="accent">.</span>
        </h2>
        <p class="cs__intro">{caseStudies.intro}</p>
      </div>
      <div class="cs__nav">
        <button class="cs__btn" type="button" data-cs-prev aria-label="Previous case study" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
        </button>
        <button class="cs__btn" type="button" data-cs-next aria-label="Next case study">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
        </button>
      </div>
    </header>
  </div>

  <div class="container cs__viewport">
    <ul class="cs__track" data-cs-track tabindex="0" aria-label="Case studies, scroll sideways for more">
      {
        caseStudies.items.map((c, i) => {
          const ch = c.chart;
          return (
            <li class="cs__card" data-cs-card={i}>
              <article class="cs__inner" aria-labelledby={`cs-client-${i}`}>
                <div class="cs__top">
                  <h3 class="cs__client" id={`cs-client-${i}`}>
                    {c.logo ? (
                      <img
                        class="cs__logo"
                        src={c.logo.src}
                        alt={c.client}
                        width={c.logo.width}
                        height={c.logo.height}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="cs__wordmark">{c.client}</span>
                    )}
                  </h3>
                  <span class="cs__sector">{c.sector}</span>
                </div>

                <div class="cs__block">
                  <h4 class="cs__label">The challenge</h4>
                  <p>{c.challenge}</p>
                </div>
                <div class="cs__block">
                  <h4 class="cs__label">What we did</h4>
                  <p>{c.work}</p>
                </div>
                <ul class="cs__tags" aria-label="Services">
                  {c.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>

                {ch.type === 'growth' && (
                  <figure class="cs__chart cs__chart--growth">
                    <div class="cs__line-wrap">
                      <svg class="cs__line" viewBox="0 0 320 170" aria-hidden="true">
                        {[0, ch.before, ch.after].map((t) => (
                          <g class="cs__gridrow">
                            <line x1={G.x0 - 24} x2={G.x1 + 16} y1={gy(t, ch.after)} y2={gy(t, ch.after)} />
                          </g>
                        ))}
                        <path
                          class="cs__area"
                          d={`M${G.x0} ${G.base} L${G.x0} ${gy(ch.before, ch.after)} L${G.x1} ${gy(ch.after, ch.after)} L${G.x1} ${G.base} Z`}
                        />
                        <path
                          class="cs__trend"
                          d={`M${G.x0} ${gy(ch.before, ch.after)} L${G.x1} ${gy(ch.after, ch.after)}`}
                          pathLength="100"
                        />
                        <circle class="cs__pt cs__pt--before" cx={G.x0} cy={gy(ch.before, ch.after)} r="6" />
                        <circle class="cs__pt cs__pt--after" cx={G.x1} cy={gy(ch.after, ch.after)} r="6" />
                        <circle class="cs__pt-pulse" cx={G.x1} cy={gy(ch.after, ch.after)} r="6" />
                        <text class="cs__xlab" x={G.x0} y="164" text-anchor="middle">{ch.beforeLabel}</text>
                        <text class="cs__xlab" x={G.x1} y="164" text-anchor="middle">{ch.afterLabel}</text>
                      </svg>
                      {[
                        { k: 'before', v: ch.before, x: G.x0, label: ch.beforeLabel },
                        { k: 'after', v: ch.after, x: G.x1, label: ch.afterLabel },
                      ].map((pt) => (
                        <span
                          class={`cs__pt-hit cs__pt-hit--${pt.k}`}
                          style={`left: ${((pt.x / 320) * 100).toFixed(2)}%; top: ${((gy(pt.v, ch.after) / 170) * 100).toFixed(2)}%`}
                          tabindex="0"
                          data-tip={`${pt.label}: ${fmt(ch.unit, pt.v, ch.suffix)} revenue`}
                          aria-label={`${pt.label}: ${fmt(ch.unit, pt.v, ch.suffix)} revenue`}
                        >
                          <span class="cs__pt-value">{fmt(ch.unit, pt.v, ch.suffix)}</span>
                        </span>
                      ))}
                      <span class="cs__growth-badge" aria-hidden="true">
                        +{Math.round(((ch.after - ch.before) / ch.before) * 100)}%
                      </span>
                    </div>
                    <figcaption class="visually-hidden">Revenue before and after working with Vistaar</figcaption>
                    <table class="visually-hidden">
                      <tr><th scope="col">Period</th><th scope="col">Revenue</th></tr>
                      <tr><td>{ch.beforeLabel}</td><td>{fmt(ch.unit, ch.before, ch.suffix)}</td></tr>
                      <tr><td>{ch.afterLabel}</td><td>{fmt(ch.unit, ch.after, ch.suffix)}</td></tr>
                    </table>
                  </figure>
                )}

                {ch.type === 'roas' && (
                  <figure class="cs__chart cs__chart--roas">
                    <div class="cs__units">
                      <div class="cs__unit-row">
                        <span class="cs__unit-label">You spend</span>
                        <span class="cs__unit-blocks">
                          <span class="cs__unit cs__unit--spend" style="--i: 0" tabindex="0" data-tip="₹1 of ad spend" aria-label="₹1 of ad spend" />
                        </span>
                        <span class="cs__unit-total">₹1</span>
                      </div>
                      <div class="cs__unit-row">
                        <span class="cs__unit-label">You get back</span>
                        <span class="cs__unit-blocks">
                          {units(ch).map((kind, k) => (
                            <span
                              class={`cs__unit cs__unit--${kind}`}
                              style={`--i: ${k + 2}`}
                              data-tip={kind === 'range' ? `Up to ₹${k + 1} back` : `₹${k + 1} back`}
                            />
                          ))}
                        </span>
                        <span class="cs__unit-total">
                          {ch.range ? `₹${ch.range[0]}–${ch.range[1]}` : `${ch.prefix ? ch.prefix + ' ' : ''}₹${ch.value}`}
                        </span>
                      </div>
                    </div>
                    <p class="cs__roas-note" aria-hidden="true">
                      <span class="cs__key cs__key--solid" />Each block is ₹1 back
                      {ch.range && (
                        <>
                          <span class="cs__key cs__key--range" />upper end of the range
                        </>
                      )}
                      <span class="cs__key cs__key--spend" />₹1 spent = break-even
                    </p>
                    <figcaption class="visually-hidden">{ch.metric}</figcaption>
                    <table class="visually-hidden">
                      <tr><th scope="col">Measure</th><th scope="col">Value</th></tr>
                      <tr><td>{ch.metric}</td><td>{ch.range ? `${ch.range[0]}–${ch.range[1]}×` : `${ch.prefix ?? ''} ${ch.value}×`}</td></tr>
                      <tr><td>Return on ₹1 of ad spend</td><td>{ch.range ? `₹${ch.range[0]}–${ch.range[1]}` : `${ch.prefix ?? ''} ₹${ch.value}`}</td></tr>
                    </table>
                  </figure>
                )}

                <p class="cs__result">
                  <strong class="cs__result-value" set:html={countUp(c.result.value)} />
                  <span class="cs__result-label">{c.result.label}</span>
                </p>
              </article>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-cs]').forEach((section) => {
    const track = section.querySelector<HTMLElement>('[data-cs-track]')!;
    const cards = [...section.querySelectorAll<HTMLElement>('[data-cs-card]')];
    const prev = section.querySelector<HTMLButtonElement>('[data-cs-prev]')!;
    const next = section.querySelector<HTMLButtonElement>('[data-cs-next]')!;
    const current = section.querySelector<HTMLElement>('[data-cs-current]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    function countUp(card: Element) {
      card.querySelectorAll<HTMLElement>('[data-cs-count]').forEach((el) => {
        const target = Number(el.dataset.csCount);
        const start = performance.now();
        const tick = (now: number) => {
          const t = Math.min(1, (now - start) / 1200);
          el.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3))));
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }

    // Charts animate and figures count up each time a card comes into view (replays after it leaves).
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting && e.intersectionRatio >= 0.35) {
            if (e.target.classList.contains('is-in')) return;
            e.target.classList.add('is-in');
            countUp(e.target);
          } else if (!e.isIntersecting) {
            e.target.classList.remove('is-in');
          }
        }),
      { threshold: [0, 0.35] },
    );
    if (reduce.matches || !('IntersectionObserver' in window)) cards.forEach((c) => c.classList.add('is-in'));
    else cards.forEach((c) => io.observe(c));
    section.classList.add('is-enhanced');

    const step = () => (cards[1] ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth);

    function sync() {
      const i = Math.round(track.scrollLeft / step());
      if (current) current.textContent = String(Math.min(cards.length, i + 1));
      prev.disabled = track.scrollLeft <= 4;
      next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
    }

    const go = (dir: number) =>
      track.scrollBy({ left: dir * step(), behavior: reduce.matches ? 'auto' : 'smooth' });
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    window.addEventListener('resize', sync);
    sync();
  });
</script>

<style>
  .cs {
    --cs-muted-mark: color-mix(in srgb, var(--color-ink) 36%, var(--color-bg));
    --cs-band: rgb(var(--color-brand-rgb) / 0.35);
    overflow: clip;
  }

  /* ---------- Header ---------- */
  .cs__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: clamp(var(--space-6), 3vw, var(--space-7));
  }

  .cs__head-text {
    display: grid;
    gap: var(--space-4);
  }

  .cs__counter {
    margin-left: 0.35em;
    font-variant-numeric: tabular-nums;
  }

  .cs__intro {
    max-width: 38rem;
    font-size: var(--fs-lead);
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }

  .cs__nav {
    display: flex;
    gap: var(--space-2);
  }

  .cs__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out);
  }

  .cs__btn svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cs__btn:not(:disabled):hover {
    background: var(--color-ink);
    color: var(--color-on-brand);
  }

  .cs__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* ---------- Track ---------- */
  .cs__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(88%, 560px);
    gap: var(--space-4);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: var(--space-2);
  }

  .cs__track::-webkit-scrollbar {
    display: none;
  }

  .cs__track:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 4px;
    border-radius: var(--radius-card);
  }

  @media (min-width: 900px) {
    .cs__track {
      grid-auto-columns: calc((100% - var(--space-5)) / 2);
      gap: var(--space-5);
    }
  }

  /* ---------- Card ---------- */
  .cs__card {
    position: relative; /* contains the visually hidden data tables */
    scroll-snap-align: start;
    display: flex;
  }

  .cs__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
    padding: clamp(var(--space-5), 2.4vw, 30px);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-bg);
  }

  .cs__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 58px;
  }

  .cs__client {
    margin: 0;
    line-height: 0;
  }

  .cs__logo {
    width: auto;
    max-width: 150px;
    max-height: 52px;
  }

  .cs__wordmark {
    font-size: 1.5rem;
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
  }

  .cs__sector {
    flex: none;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }

  .cs__block {
    display: grid;
    gap: var(--space-1);
  }

  .cs__label {
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-brand);
  }

  .cs__block p {
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--color-text);
  }

  .cs__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .cs__tags li {
    padding: 5px 12px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }

  /* ---------- Charts (shared) ---------- */
  .cs__chart {
    margin: var(--space-2) 0 0;
    padding: var(--space-4) var(--space-4) var(--space-3);
    border-radius: 14px;
    background: var(--color-surface);
  }

  /* Hover / focus tooltip on marks */
  [data-tip] {
    position: relative;
    outline: none;
  }

  [data-tip]::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    z-index: 3;
    padding: 5px 9px;
    border-radius: 6px;
    background: var(--color-ink);
    color: var(--color-on-brand);
    font-size: 0.75rem;
    font-weight: var(--fw-semibold);
    white-space: nowrap;
    opacity: 0;
    transform: translate(-50%, 4px);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
    pointer-events: none;
  }

  [data-tip]:hover::after,
  [data-tip]:focus-visible::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  [data-tip]:focus-visible {
    box-shadow: 0 0 0 2px var(--color-surface), 0 0 0 4px var(--color-ink);
  }

  /* ---------- Growth: two-point line chart with area wash ---------- */
  .cs__line-wrap {
    position: relative;
  }

  .cs__line {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .cs__gridrow line {
    stroke: color-mix(in srgb, var(--color-ink) 12%, transparent);
    stroke-width: 1;
  }

  .cs__gridrow text,
  .cs__xlab {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: var(--fw-semibold);
    fill: var(--color-text-muted);
  }

  .cs__xlab {
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cs__area {
    fill: rgb(var(--color-brand-rgb) / 0.1);
  }

  .cs__trend {
    fill: none;
    stroke: var(--color-brand);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
  }

  .cs__pt {
    stroke: var(--color-surface);
    stroke-width: 2;
  }

  .cs__pt--before {
    fill: var(--cs-muted-mark);
  }

  .cs__pt--after {
    fill: var(--color-brand);
  }

  .cs__pt-pulse {
    fill: none;
    stroke: var(--color-brand);
    stroke-width: 2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  /* HTML hit targets + value labels over the two points */
  .cs__pt-hit {
    position: absolute;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    cursor: default;
  }

  .cs__pt-value {
    position: absolute;
    bottom: calc(100% + 2px);
    left: 50%;
    font-size: var(--fs-body);
    font-weight: var(--fw-bold);
    white-space: nowrap;
    color: var(--color-ink);
    transform: translateX(-50%);
  }

  .cs__growth-badge {
    position: absolute;
    left: 54%;
    top: 34%;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-brand);
    color: var(--color-on-brand);
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    transform: translate(-50%, -50%) rotate(-8deg);
  }

  /* ---------- ROAS: unit blocks, one per ₹1 ---------- */
  .cs__units {
    display: grid;
    gap: var(--space-3);
  }

  .cs__unit-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    align-items: center;
    gap: var(--space-3);
  }

  .cs__unit-label {
    font-size: 0.75rem;
    font-weight: var(--fw-bold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .cs__unit-blocks {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
  }

  .cs__unit {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 4px;
  }

  .cs__unit--spend {
    background: var(--color-ink);
  }

  .cs__unit--solid {
    background: var(--color-brand);
  }

  .cs__unit--range {
    background: var(--cs-band);
  }

  .cs__unit-total {
    font-size: var(--fs-body);
    font-weight: var(--fw-bold);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-ink);
  }

  .cs__roas-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 6px;
    margin-top: var(--space-3);
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
  }

  .cs__key {
    width: 9px;
    height: 9px;
    margin-left: 6px;
    border-radius: 2px;
  }

  .cs__key:first-child {
    margin-left: 0;
  }

  .cs__key--solid {
    background: var(--color-brand);
  }

  .cs__key--range {
    background: var(--cs-band);
  }

  .cs__key--spend {
    background: var(--color-ink);
  }

  @media (min-width: 900px) {
    .cs__unit {
      width: 20px;
      height: 20px;
    }
  }

  @media (max-width: 479px) {
    .cs__unit-row {
      grid-template-columns: 1fr auto;
    }

    .cs__unit-label {
      grid-column: 1 / -1;
    }

    .cs__unit {
      width: 14px;
      height: 14px;
    }
  }

  /* ---------- Result bar ---------- */
  .cs__result {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    margin-top: auto;
    padding: var(--space-4) var(--space-5);
    border-radius: 12px;
    background: var(--color-ink);
    color: var(--color-on-brand);
  }

  .cs__result-value {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
    font-weight: var(--fw-bold);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .cs__result-label {
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: rgb(255 255 255 / 0.78);
  }

  /* ---------- Entrance (replays each time a card enters view) ---------- */
  .cs.is-enhanced .cs__trend {
    stroke-dashoffset: 100;
  }

