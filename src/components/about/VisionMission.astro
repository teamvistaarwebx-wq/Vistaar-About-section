---
import { visionMission as vm } from '../../data/about.js';
---

<section class="section section--surface vm" aria-labelledby="vm-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow" id="vm-title">{vm.eyebrow}</p>
    </header>

    <div class="vm__grid">
      <div class="vm__vision" data-reveal>
        <h2 class="vm__label">{vm.visionLabel}</h2>
        <p class="vm__statement">{vm.vision}</p>
        <p class="vm__detail">{vm.visionDetail}</p>
      </div>

      <div class="vm__mission" data-reveal>
        <h2 class="vm__label">{vm.missionLabel}</h2>
        <p class="vm__mission-text">{vm.mission}</p>
        <ol class="vm__questions">
          {
            vm.questions.map((q, i) => (
              <li>
                <span class="vm__q-num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span>{q}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .vm__grid {
    display: grid;
    gap: var(--space-6);
  }

  .vm__label {
    margin-bottom: var(--space-4);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-brand);
  }

  .vm__statement {
    font-size: clamp(1.625rem, 1.2rem + 1.8vw, 2.75rem);
    font-weight: var(--fw-semibold);
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .vm__detail {
    max-width: 36rem;
    margin-top: var(--space-5);
    font-size: var(--fs-lead);
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }

  .vm__mission {
    padding: clamp(var(--space-5), 4vw, var(--space-7));
    border-radius: var(--radius-card);
    background: var(--color-bg);
  }

  .vm__mission-text {
    font-size: var(--fs-lead);
    font-weight: var(--fw-semibold);
    line-height: 1.35;
  }

  .vm__questions {
    display: grid;
    gap: 0;
    margin-top: var(--space-5);
  }

  .vm__questions li {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-line);
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }

  .vm__q-num {
    flex: none;
    min-width: 2ch;
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    color: var(--color-brand);
  }

  @media (min-width: 768px) {
    .vm__questions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .vm__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(var(--space-7), 6vw, 120px);
      align-items: start;
    }

    .vm__vision {
      position: sticky;
      top: var(--space-7);
    }
  }
</style>
