---
/**
 * How we work: the six-step loop.
 *
 * Centred heading + subheading, then a ring diagram (design reference): six steps around a circle,
 * icons in circular nodes, grey track with direction arrows, a red dashed loop from Improve back
 * to Research, and "What we learn feeds the next decision." in the centre.
 *
 * Scroll story (motion allowed): the diagram pins; a red line draws around the ring and each node
 * fills red as the line reaches it (Research → Diagnose → … → Improve). Once Improve is filled the
 * dashed loop flows back to Research and the centre lights up. A caption names the current step.
 * Reduced motion / no JS: the finished diagram is shown at rest.
 *
 * Geometry: viewBox 600×600, centre (300,300), radius 200. Step i sits at i × 60° clockwise from top.
 */
import { howWeWork as hw } from '../../data/about.js';

const R = 200;
const C = 300;
const n = hw.steps.length;
const pos = hw.steps.map((_, i) => {
  const a = (i * 2 * Math.PI) / n;
  return { x: C + R * Math.sin(a), y: C - R * Math.cos(a) };
});
const side = (i: number) => (i === 0 ? 'top' : i === n / 2 ? 'bottom' : i < n / 2 ? 'right' : 'left');
const last = pos[n - 1];
const f = (v: number) => v.toFixed(1);
// Track drawn by scroll: top → clockwise → last step. Loop: last step → top.
const progressPath = `M${C} ${C - R} A${R} ${R} 0 1 1 ${f(last.x)} ${f(last.y)}`;
const loopPath = `M${f(last.x)} ${f(last.y)} A${R} ${R} 0 0 1 ${C} ${C - R}`;
const pad = (i: number) => String(i + 1).padStart(2, '0');

// Stroke icons (24×24), one per step
const icons = [
  '<circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/>', // research: magnifier
  '<path d="M14.7 6.3a4 4 0 0 0-5.3 5.2L4 16.9V20h3.1l5.4-5.4a4 4 0 0 0 5.2-5.3l-2.6 2.6-2.3-.6-.6-2.3z"/>', // diagnose: wrench
  '<path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.6 10.8c.7.6 1.1 1.3 1.1 2.2h5c0-.9.4-1.6 1.1-2.2A6 6 0 0 0 12 3z"/>', // design: bulb
  '<path d="M8 5.5v13l10.5-6.5z"/>', // execute: play
  '<path d="M4 20h16M7 17v-6M12 17V6M17 17v-9"/>', // measure: bars
  '<rect x="3.5" y="5" width="17" height="14" rx="2"/><path d="M7 15l3-3.5 3 2 4-4.5"/>', // improve: trend
];
const centreIcon = icons[5];
---

<section class="hw" aria-labelledby="hw-title" data-hw>
  <header class="container hw__head">
    <p class="eyebrow">{hw.eyebrow}</p>
    <h2 class="hw__title" id="hw-title">
      {hw.heading.lead} <span class="accent">{hw.heading.accent}</span>{hw.heading.tail}
    </h2>
    <p class="hw__sub">{hw.intro}</p>
  </header>

  <div class="hw__stage" data-hw-stage>
    <div class="hw__pin">
      <div class="hw__diagram" data-hw-diagram>
        <svg class="hw__ring" viewBox="0 0 600 600" aria-hidden="true">
          <circle class="hw__track" cx={C} cy={C} r={R} />
          {
            [0, 1, 2, 3, 4].map((k) => (
              <polygon
                class="hw__arrow"
                data-hw-arrow={k}
                points={`${C - 5},${C - R - 6} ${C + 5},${C - R} ${C - 5},${C - R + 6}`}
                transform={`rotate(${30 + k * 60} ${C} ${C})`}
              />
            ))
          }
          <path class="hw__progress" d={progressPath} pathLength="100" data-hw-progress />
          <path class="hw__loop" d={loopPath} />
          <polygon
            class="hw__arrow hw__arrow--loop"
            points={`${C - 5},${C - R - 6} ${C + 5},${C - R} ${C - 5},${C - R + 6}`}
            transform={`rotate(330 ${C} ${C})`}
          />
        </svg>

        <div class="hw__centre">
          <svg class="hw__centre-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={centreIcon} />
          <p>{hw.loopNote}</p>
        </div>

        <ol class="hw__steps">
          {
            hw.steps.map((step, i) => (
              <li
                class:list={['hw__step', `hw__step--${side(i)}`]}
                style={`left: ${f(pos[i].x / 6)}%; top: ${f(pos[i].y / 6)}%`}
                data-hw-step={i}
              >
                <span class="hw__node" aria-hidden="true">
                  <span class="hw__node-fill" />
                  <svg viewBox="0 0 24 24" set:html={icons[i]} />
                </span>
                <span class="hw__label">
                  <span class="hw__lnum">{pad(i)}</span> <span class="hw__lname">{step}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>

      <p class="hw__caption" aria-hidden="true" data-hw-caption>
        <span class="hw__caption-count" data-hw-count>Step 01 of {pad(n - 1)}</span>
        <span class="hw__caption-name" data-hw-name>{hw.steps[0]}</span>
      </p>
    </div>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const clamp = (v: number) => Math.min(1, Math.max(0, v));

  document.querySelectorAll<HTMLElement>('[data-hw]').forEach((section) => {
    const stage = section.querySelector<HTMLElement>('[data-hw-stage]')!;
    const diagram = section.querySelector<HTMLElement>('[data-hw-diagram]')!;
    const progress = section.querySelector<SVGPathElement>('[data-hw-progress]')!;
    const steps = [...section.querySelectorAll<HTMLElement>('[data-hw-step]')];
    const arrows = [...section.querySelectorAll<SVGElement>('[data-hw-arrow]')];
    const count = section.querySelector<HTMLElement>('[data-hw-count]')!;
    const name = section.querySelector<HTMLElement>('[data-hw-name]')!;
    const names = steps.map((s) => s.querySelector('.hw__lname')?.textContent ?? '');
    const n = steps.length;
    const pad = (i: number) => String(i + 1).padStart(2, '0');
    const START = 0.04; // first node lights as the pin begins
    const SPAN = 0.75; // the red line reaches the last node at START + SPAN
    const LOOP = 0.86; // then the loop back to Research plays

    let enhanced = false;
    let queued = false;
    let lastLit = -2;
    let looped = false;

    function update() {
      queued = false;
      if (!enhanced) return;
      const rect = stage.getBoundingClientRect();
      const total = stage.offsetHeight - window.innerHeight;
      const p = total > 0 ? clamp(-rect.top / total) : 1;

      const arc = clamp((p - START) / SPAN);
      progress.style.strokeDashoffset = String(100 - arc * 100);

      // Steps fill when the red line reaches them (evenly spaced along the drawn track).
      const lit = p < START ? -1 : Math.min(n - 1, Math.floor(arc * (n - 1) + 0.0001));
      const isLooped = p >= LOOP;
      if (lit !== lastLit || isLooped !== looped) {
        lastLit = lit;
        looped = isLooped;
        steps.forEach((s, i) => {
          s.classList.toggle('is-filled', i <= lit);
          s.classList.toggle('is-active', i === lit && !isLooped);
        });
        // An arrow turns red once the line has passed it (segment k ends at node k + 1).
        arrows.forEach((a, k) => a.classList.toggle('is-on', lit > k));
        diagram.classList.toggle('is-looped', isLooped);
        const shown = Math.max(0, lit);
        count.textContent = isLooped ? 'And again' : `Step ${pad(shown)} of ${pad(n - 1)}`;
        name.textContent = isLooped ? `Back to ${names[0].toLowerCase()}` : names[shown];
      }
    }

    function onScroll() {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    }

    let listening = false;
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !listening) window.addEventListener('scroll', onScroll, { passive: true });
      if (!e.isIntersecting && listening) window.removeEventListener('scroll', onScroll);
      listening = e.isIntersecting;
      onScroll();
    }, { rootMargin: '20% 0px' });

    function applyMode() {
      enhanced = !reduce.matches;
      section.classList.toggle('is-enhanced', enhanced);
      lastLit = -2;
      if (enhanced) {
        io.observe(section);
        update();
      } else {
        io.disconnect();
        progress.style.strokeDashoffset = '';
        steps.forEach((s) => {
          s.classList.add('is-filled');
          s.classList.remove('is-active');
        });
        arrows.forEach((a) => a.classList.add('is-on'));
        diagram.classList.add('is-looped');
      }
    }

    reduce.addEventListener('change', applyMode);
    window.addEventListener('resize', onScroll, { passive: true });
    applyMode();
  });
</script>

<style>
  .hw {
    padding-top: var(--space-section);
    background: var(--color-surface);
  }

  /* ---------- Heading ---------- */
  .hw__head {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .hw__title {
    max-width: 18ch;
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-heading);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .hw__sub {
    max-width: 36rem;
    font-size: var(--fs-lead);
    font-weight: var(--fw-medium);
    color: var(--color-text);
    text-wrap: balance;
  }

  /* ---------- Stage / pin ---------- */
  .hw__pin {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-7) var(--space-section);
  }

  .hw.is-enhanced .hw__stage {
    height: 280vh;
  }

  .hw.is-enhanced .hw__pin {
    position: sticky;
    top: 0;
    justify-content: center;
    height: 100vh;
    height: 100svh;
    padding-block: var(--space-5);
  }

  /* ---------- Diagram ---------- */
  .hw__diagram {
    --label-space: 0px;
    --d: min(560px, calc(100svh - 170px), calc(100vw - var(--gutter) * 2 - var(--label-space) * 2));
    position: relative;
    width: var(--d);
    aspect-ratio: 1;
    flex: none;
  }

  @media (min-width: 640px) {
    .hw__diagram {
      --label-space: 170px;
    }
  }

  .hw__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .hw__track {
    fill: none;
    stroke: color-mix(in srgb, var(--color-ink) 16%, transparent);
    stroke-width: 2;
  }

  .hw__arrow {
    fill: color-mix(in srgb, var(--color-ink) 35%, transparent);
    transition: fill 400ms var(--ease-out);
  }

  .hw__arrow.is-on,
  .hw:not(.is-enhanced) .hw__arrow {
    fill: var(--color-brand);
  }

  .hw__arrow--loop {
    fill: var(--color-brand);
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
  }

  .hw__progress {
    fill: none;
    stroke: var(--color-brand);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 0; /* drawn by scroll when enhanced */
  }

  .hw.is-enhanced .hw__progress {
    stroke-dashoffset: 100;
  }

  .hw__loop {
    fill: none;
    stroke: var(--color-brand);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 7 9;
    opacity: 0;
    transition: opacity 500ms var(--ease-out);
  }

  .hw__diagram.is-looped .hw__loop,
  .hw__diagram.is-looped .hw__arrow--loop,
  .hw:not(.is-enhanced) .hw__loop,
  .hw:not(.is-enhanced) .hw__arrow--loop {
    opacity: 1;
  }

  /* The dashed loop flows from Improve back to Research */
  .hw__diagram.is-looped .hw__loop {
    animation: hw-flow 1.2s linear infinite;
  }

  @keyframes hw-flow {
    to {
      stroke-dashoffset: -32;
    }
  }

  /* Centre message */
  .hw__centre {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    width: 46%;
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .hw__centre p {
    font-size: clamp(0.8125rem, 0.7rem + 0.5vw, 1.0625rem);
    font-weight: var(--fw-medium);
    line-height: 1.35;
    color: var(--color-text-muted);
    transition: color 500ms var(--ease-out);
  }

  .hw__centre-icon {
    width: clamp(20px, 4.5%, 28px);
    height: auto;
    fill: none;
    stroke: var(--color-brand);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 600ms var(--ease-out);
  }

  .hw__diagram.is-looped .hw__centre p,
  .hw:not(.is-enhanced) .hw__centre p {
    color: var(--color-ink);
  }

  .hw__diagram.is-looped .hw__centre-icon {
    transform: scale(1.25);
  }

  /* ---------- Steps ---------- */
  .hw__steps {
    position: absolute;
    inset: 0;
  }

  .hw__step {
    position: absolute;
    width: 0;
    height: 0;
  }

  .hw__node {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: calc(var(--d) * 0.12);
    height: calc(var(--d) * 0.12);
    min-width: 40px;
    min-height: 40px;
    border: 2px solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-bg);
    transform: translate(-50%, -50%);
    transition: border-color 400ms var(--ease-out);
  }

  /* Red fill grows from the centre when the line reaches the node */
  .hw__node-fill {
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    background: var(--color-brand);
    transform: scale(0);
    transition: transform 550ms cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  .hw__node svg {
    position: relative;
    width: 42%;
    height: 42%;
    fill: none;
    stroke: var(--color-brand);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 300ms var(--ease-out);
  }

  .hw__step.is-filled .hw__node,
  .hw:not(.is-enhanced) .hw__node {
    border-color: var(--color-brand);
  }

  .hw__step.is-filled .hw__node-fill,
  .hw:not(.is-enhanced) .hw__node-fill {
    transform: scale(1);
  }

  .hw__step.is-filled .hw__node svg,
  .hw:not(.is-enhanced) .hw__node svg {
    stroke: var(--color-on-brand);
  }

  /* Current step pulses */
  .hw__step.is-active .hw__node::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 2px solid var(--color-brand);
    animation: hw-pulse 1.6s var(--ease-out) infinite;
  }

  @keyframes hw-pulse {
    from {
      opacity: 0.6;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(1.6);
    }
  }

  /* Labels sit outside the ring, on the node's side */
  .hw__label {
    position: absolute;
    display: block;
    width: max-content;
    max-width: 160px;
    font-size: clamp(0.8125rem, 0.75rem + 0.3vw, 1rem);
    font-weight: var(--fw-bold);
    letter-spacing: 0.03em;
    line-height: 1.2;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-ink) 45%, transparent);
    transition: color 400ms var(--ease-out);
  }

  .hw__lnum {
    color: color-mix(in srgb, var(--color-brand) 55%, transparent);
    transition: color 400ms var(--ease-out);
  }

  .hw__step.is-filled .hw__label,
  .hw:not(.is-enhanced) .hw__label {
    color: var(--color-ink);
  }

  .hw__step.is-filled .hw__lnum,
  .hw:not(.is-enhanced) .hw__lnum {
    color: var(--color-brand);
  }

  .hw__step--top .hw__label,
  .hw__step--bottom .hw__label {
    max-width: 260px;
  }

  .hw__step--top .hw__label {
    left: 0;
    bottom: calc(var(--d) * 0.06 + 14px);
    transform: translateX(-50%);
    text-align: center;
  }

  .hw__step--bottom .hw__label {
    left: 0;
    top: calc(var(--d) * 0.06 + 14px);
    transform: translateX(-50%);
    text-align: center;
  }

  .hw__step--right .hw__label {
    left: calc(var(--d) * 0.06 + 14px);
    top: 0;
    transform: translateY(-50%);
  }

  .hw__step--left .hw__label {
    right: calc(var(--d) * 0.06 + 14px);
    top: 0;
    transform: translateY(-50%);
    text-align: right;
  }

  /* Phones: no room beside the ring, so show only the step number there; the caption names it */
  @media (max-width: 639px) {
    .hw__lname {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .hw__step--top .hw__label,
    .hw__step--bottom .hw__label {
      bottom: auto;
      top: auto;
    }

    .hw__step--top .hw__label {
      bottom: calc(max(var(--d) * 0.06, 20px) + 6px);
    }

    .hw__step--bottom .hw__label {
      top: calc(max(var(--d) * 0.06, 20px) + 6px);
    }

    .hw__step--right .hw__label {
      left: calc(max(var(--d) * 0.06, 20px) + 6px);
    }

    .hw__step--left .hw__label {
      right: calc(max(var(--d) * 0.06, 20px) + 6px);
    }
  }

  /* ---------- Caption ---------- */
  .hw__caption {
    display: grid;
    justify-items: center;
    gap: 2px;
    min-height: 3.2em;
    text-align: center;
  }

  .hw:not(.is-enhanced) .hw__caption {
    display: none;
  }

  .hw__caption-count {
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-brand);
  }

  .hw__caption-name {
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    font-weight: var(--fw-semibold);
    color: var(--color-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .hw__step.is-active .hw__node::after,
    .hw__diagram.is-looped .hw__loop {
      animation: none;
    }
  }
</style>
