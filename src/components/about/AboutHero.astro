---
import { hero } from '../../data/about.js';
---

<section class="hero" aria-labelledby="about-title">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__inner">
    <p class="eyebrow eyebrow--plain eyebrow--brand hero__eyebrow">{hero.eyebrow}</p>
    <h1 class="hero__title" id="about-title">
      {hero.headline.lead} <span class="accent">{hero.headline.accent}</span>
    </h1>
    <p class="hero__sub">{hero.sub}</p>
    <ul class="hero__facts" aria-label="At a glance">
      {hero.facts.map((fact) => <li>{fact}</li>)}
    </ul>
  </div>
</section>

<style>
  /* Mirrors the home hero (Figma 7:700): left-aligned display type over a red radial glow. */
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(var(--space-7), 8vw, 152px) clamp(var(--space-8), 14vw, 220px);
  }

  .hero__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 70% 60% at 62% 108%,
      rgb(var(--color-red-rgb) / 1) 0%,
      rgb(var(--color-red-rgb) / 0.85) 22%,
      rgb(var(--color-red-rgb) / 0.45) 42%,
      rgb(var(--color-red-rgb) / 0.15) 62%,
      rgb(var(--color-red-rgb) / 0) 80%
    );
    opacity: 0.8;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: var(--space-5);
  }

  .hero__title {
    max-width: 14ch;
    font-size: var(--fs-display);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-tight);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .hero__sub {
    max-width: 40rem;
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .hero__facts li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    background: var(--color-glass);
    box-shadow: var(--shadow-float);
    backdrop-filter: blur(12.9px);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
  }

  .hero__facts li::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-brand);
  }

  @media (min-width: 1024px) {
    .hero__title {
      max-width: 16ch;
    }
  }
</style>
