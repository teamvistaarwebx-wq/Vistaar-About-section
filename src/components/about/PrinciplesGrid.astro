---
import { principles } from '../../data/about.js';
---

<section class="section principles" aria-labelledby="principles-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">{principles.eyebrow}</p>
      <h2 class="section-title" id="principles-title" data-reveal>{principles.title}</h2>
    </header>

    <ol class="principles__grid">
      {
        principles.items.map((item, i) => (
          <li class="principles__card" data-reveal style={`--reveal-i: ${i % 4}`}>
            <span class="principles__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="principles__title">{item.title}</h3>
            <p class="principles__text">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .principles__grid {
    display: grid;
    gap: var(--space-3);
  }

  .principles__card {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-bg);
    transition: transform var(--dur-base) var(--ease-out), opacity var(--dur-slow) var(--ease-out);
  }

  .principles__card::after {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1px solid var(--color-brand);
    border-radius: inherit;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
    pointer-events: none;
  }

  .principles__card:hover::after {
    opacity: 1;
  }

  .principles__num {
    margin-bottom: var(--space-4);
    font-size: clamp(2rem, 1.6rem + 1.4vw, 3rem);
    font-weight: var(--fw-semibold);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-brand);
  }

  .principles__title {
    font-size: var(--fs-card-title);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
  }

  .principles__text {
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }

  @media (min-width: 768px) {
    .principles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .principles__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
    }

    .principles__card {
      min-height: 280px;
    }
  }
</style>
