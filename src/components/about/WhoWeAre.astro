---
/**
 * Who we are + six disciplines (minimal).
 *
 * Left: a flat visual that changes with the open discipline, intro paragraph below.
 * Right: a hairline list. Each row is "01  Brand  +". Opening a row turns its number red,
 * swaps the + for a −, and reveals one quiet line of what the discipline covers.
 * The visual crossfades to the selected discipline.
 *
 * Accessible accordion (buttons with aria-expanded); arrow keys move between rows.
 * A discipline's `image` (src/data/about.js) fills the visual; without one a flat panel shows.
 */
import { whoWeAre } from '../../data/about.js';

const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<section class="section who" aria-labelledby="who-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">{whoWeAre.eyebrow}</p>
      <h2 class="section-title" id="who-title" data-reveal>{whoWeAre.title}</h2>
    </header>

    <div class="dx" data-dx>
      <div class="dx__left">
        <div class="dx__stage" aria-hidden="true">
          {
            whoWeAre.disciplines.map((d, i) => (
              <div
                class:list={['dx__panel', { 'is-active': i === 0 }]}
                data-dx-panel={i}
              >
                {d.image ? (
                  <img class="dx__img" src={d.image} alt="" width="900" height="900" loading="lazy" decoding="async" />
                ) : (
                  <>
                    <span class="dx__art-num">{pad(i)}</span>
                    <span class="dx__art-name">{d.name}</span>
                  </>
                )}
              </div>
            ))
          }
        </div>
        <p class="dx__intro">{whoWeAre.intro}</p>
      </div>

      <div class="dx__right">
        <p class="dx__label">{whoWeAre.disciplinesLabel}</p>
        <ol class="dx__list">
          {
            whoWeAre.disciplines.map((d, i) => (
              <li class:list={['dx__item', { 'is-open': i === 0 }]} data-dx-item={i}>
                <h3 class="dx__heading">
                  <button
                    class="dx__trigger"
                    type="button"
                    id={`dx-btn-${i}`}
                    aria-expanded={i === 0 ? 'true' : 'false'}
                    aria-controls={`dx-body-${i}`}
                    data-dx-btn={i}
                  >
                    <span class="dx__num" aria-hidden="true">
                      {pad(i)}
                    </span>
                    <span class="dx__name">{d.name}</span>
                    <span class="dx__icon" aria-hidden="true" />
                  </button>
                </h3>
                <div class="dx__body" id={`dx-body-${i}`} role="region" aria-labelledby={`dx-btn-${i}`}>
                  <div class="dx__body-inner">
                    <ul class="dx__covers">
                      {d.covers.map((c) => (
                        <li>{c}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="dx__note">{whoWeAre.disciplinesNote}</p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-dx]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLElement>('[data-dx-item]')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-dx-btn]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-dx-panel]')];
    let active = 0;

    function open(i: number) {
      if (i === active) return;
      active = i;
      items.forEach((item, k) => item.classList.toggle('is-open', k === i));
      buttons.forEach((btn, k) => btn.setAttribute('aria-expanded', String(k === i)));
      panels.forEach((panel, k) => panel.classList.toggle('is-active', k === i));
    }

    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => open(i));
      btn.addEventListener('keydown', (e) => {
        const n = buttons.length;
        let next = -1;
        if (e.key === 'ArrowDown') next = (i + 1) % n;
        else if (e.key === 'ArrowUp') next = (i - 1 + n) % n;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = n - 1;
        if (next < 0) return;
        e.preventDefault();
        buttons[next].focus();
      });
    });

    root.classList.add('is-enhanced');
  });
</script>

<style>
  .dx {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 900px) {
    .dx {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(var(--space-7), 6vw, 112px);
      align-items: start;
    }

    .dx__left {
      position: sticky;
      top: var(--space-6);
    }
  }

  /* ---------- Left ---------- */
  .dx__left {
    display: grid;
    gap: var(--space-5);
  }

  .dx__stage {
    position: relative;
    container-type: inline-size;
    display: grid;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  @media (min-width: 900px) {
    .dx__stage {
      aspect-ratio: 1 / 1;
    }
  }

  /* Placeholder until photos arrive: quiet surface panel, dark name, red number */
  .dx__panel {
    grid-area: 1 / 1;
    position: relative;
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .dx__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dx__art-num {
    position: absolute;
    top: var(--space-5);
    left: var(--space-5);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    color: var(--color-brand);
  }

  .dx__art-name {
    position: absolute;
    left: var(--space-5);
    bottom: var(--space-5);
    font-size: clamp(1.5rem, 10cqw, 3.25rem);
    font-weight: var(--fw-medium);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .dx__intro {
    max-width: 34rem;
    font-size: var(--fs-body);
    font-weight: var(--fw-regular);
    line-height: 1.6;
    color: var(--color-text);
  }

  /* Crossfade between visuals; the name rises slightly */
  .dx.is-enhanced .dx__panel {
    opacity: 0;
    transition: opacity 500ms var(--ease-out);
  }

  .dx.is-enhanced .dx__panel.is-active {
    opacity: 1;
  }

  .dx.is-enhanced .dx__art-name,
  .dx.is-enhanced .dx__img {
    transform: translate3d(0, 10px, 0);
    transition: transform 700ms var(--ease-out);
  }

  .dx.is-enhanced .dx__img {
    transform: scale(1.04);
  }

  .dx.is-enhanced .is-active .dx__art-name,
  .dx.is-enhanced .is-active .dx__img {
    transform: none;
  }

  .dx:not(.is-enhanced) .dx__panel:not(.is-active) {
    display: none;
  }

  /* ---------- Right: hairline accordion ---------- */
  .dx__right {
    display: grid;
    gap: var(--space-4);
  }

  .dx__label {
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
  }

  .dx__list {
    border-bottom: 1px solid var(--color-line);
  }

  .dx__item {
    border-top: 1px solid var(--color-line);
  }

  .dx__heading {
    margin: 0;
  }

  .dx__trigger {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    padding: clamp(var(--space-4), 1.6vw, 26px) 0;
    border: 0;
    background: none;
    color: var(--color-ink);
    text-align: left;
    cursor: pointer;
  }

  .dx__num {
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
    transition: color 300ms var(--ease-out);
  }

  .dx__name {
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    font-weight: var(--fw-medium);
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--color-text-muted);
    transition: color 300ms var(--ease-out);
  }

  .dx__trigger:hover .dx__name,
  .dx__item.is-open .dx__name {
    color: var(--color-ink);
  }

  .dx__item.is-open .dx__num {
    color: var(--color-brand);
  }

  /* + / − marker: two hairlines, the vertical one collapses when open */
  .dx__icon {
    position: relative;
    width: 14px;
    height: 14px;
  }

  .dx__icon::before,
  .dx__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    margin-top: -0.75px;
    background: currentColor;
    transition: transform 350ms var(--ease-out);
  }

  .dx__icon::after {
    transform: rotate(90deg);
  }

  .dx__item.is-open .dx__icon::after {
    transform: rotate(0deg);
  }

  .dx__trigger:focus-visible {
    outline: none;
  }

  .dx__trigger:focus-visible .dx__name {
    text-decoration: underline;
    text-decoration-color: var(--color-brand);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .dx__body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 450ms var(--ease-out);
  }

  .dx__item.is-open .dx__body {
    grid-template-rows: 1fr;
  }

  .dx__body-inner {
    min-height: 0;
    overflow: hidden;
  }

  .dx__covers {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-1) 0 clamp(var(--space-4), 1.6vw, 26px) calc(2.5rem + var(--space-3));
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    letter-spacing: 0.04em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--color-text);
    opacity: 0;
    transition: opacity 250ms var(--ease-out);
  }

  .dx__item.is-open .dx__covers {
    opacity: 1;
    transition: opacity 400ms var(--ease-out) 150ms;
  }

  /* Red-dot markers: "• BRAND STRATEGY  • POSITIONING  • NAMING" (each item keeps its own dot when wrapping) */
  .dx__covers li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .dx__covers li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand);
  }

  .dx__note {
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  @media (max-width: 599px) {
    .dx__trigger {
      grid-template-columns: 2rem 1fr auto;
    }

    .dx__covers {
      padding-left: calc(2rem + var(--space-3));
    }
  }
</style>
