---
/**
 * Who we are + six disciplines.
 *
 * Left: eyebrow, title, intro paragraph and a "Start a project" button.
 * Right: a large hairline list "1  Brand". Hovering a row (mouse), focusing it (keyboard) or
 * tapping it (touch) opens it: a soft panel fades in behind the row, the name darkens and
 * nudges right, its number turns red, and its capabilities unfold below as red-dot tags.
 * Moving the mouse off the list closes it again (as in the reference recording).
 *
 * Accessible disclosure list: each row is a button with aria-expanded controlling its tags.
 */
import { whoWeAre } from '../../data/about.js';
---

<section class="section who" aria-labelledby="who-title">
  <div class="container dx">
    <div class="dx__intro-col">
      <p class="eyebrow">{whoWeAre.eyebrow}</p>
      <h2 class="dx__title" id="who-title">{whoWeAre.title}</h2>
      <p class="dx__intro">{whoWeAre.intro}</p>
      <a class="btn btn--brand dx__cta" href={whoWeAre.cta.href}>{whoWeAre.cta.label}</a>
    </div>

    <ol class="dx__list" aria-label={whoWeAre.disciplinesLabel} data-dx>
      {
        whoWeAre.disciplines.map((d, i) => (
          <li class="dx__item" data-dx-item={i}>
            <h3 class="dx__heading">
              <button
                class="dx__trigger"
                type="button"
                id={`dx-btn-${i}`}
                aria-expanded="false"
                aria-controls={`dx-body-${i}`}
                data-dx-btn={i}
              >
                <span class="dx__num" aria-hidden="true">
                  {i + 1}
                </span>
                <span class="dx__name">{d.name}</span>
              </button>
            </h3>
            <div class="dx__body" id={`dx-body-${i}`} role="region" aria-labelledby={`dx-btn-${i}`}>
              <div class="dx__body-inner">
                <ul class="dx__covers">
                  {d.covers.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-dx]').forEach((list) => {
    const items = [...list.querySelectorAll<HTMLElement>('[data-dx-item]')];
    const buttons = [...list.querySelectorAll<HTMLButtonElement>('[data-dx-btn]')];
    const hoverable = window.matchMedia('(hover: hover) and (pointer: fine)');
    let active = -1;
    let lastPointer = '';

    function open(i: number) {
      if (i === active) return;
      active = i;
      items.forEach((item, k) => item.classList.toggle('is-open', k === i));
      buttons.forEach((btn, k) => btn.setAttribute('aria-expanded', String(k === i)));
    }

    items.forEach((item, i) => {
      item.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse' && hoverable.matches) open(i);
      });
    });

    list.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse' && hoverable.matches) open(-1);
    });

    buttons.forEach((btn, i) => {
      btn.addEventListener('pointerdown', (e) => (lastPointer = e.pointerType));
      btn.addEventListener('click', () => {
        // Mouse: hovering already opened it, so a click keeps it open. Touch / keyboard: toggle.
        if (lastPointer === 'mouse' && hoverable.matches) open(i);
        else open(active === i ? -1 : i);
        lastPointer = '';
      });
      btn.addEventListener('keydown', (e) => {
        const n = buttons.length;
        let next = -1;
        if (e.key === 'ArrowDown') next = (i + 1) % n;
        else if (e.key === 'ArrowUp') next = (i - 1 + n) % n;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = n - 1;
        else if (e.key === 'Escape') open(-1);
        if (next < 0) return;
        e.preventDefault();
        buttons[next].focus();
      });
    });

    // Keyboard: the focused row opens; leaving the list closes it.
    buttons.forEach((btn, i) => btn.addEventListener('focus', () => lastPointer === '' && open(i)));
    list.addEventListener('focusout', (e) => {
      if (!list.contains(e.relatedTarget as Node)) open(-1);
    });
  });
</script>

<style>
  .dx {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 900px) {
    .dx {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(var(--space-7), 8vw, 160px);
      align-items: start;
    }

    .dx__intro-col {
      position: sticky;
      top: var(--space-7);
    }
  }

  /* ---------- Left ---------- */
  .dx__intro-col {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .dx__title {
    max-width: 16ch;
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-heading);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .dx__intro {
    max-width: 34rem;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--color-text);
  }

  .dx__cta {
    min-width: min(100%, 15rem);
    margin-top: var(--space-2);
  }

  /* ---------- Right: list ---------- */
  .dx__list {
    --row-size: clamp(1.75rem, 1.2rem + 2.4vw, 3.25rem);
    --row-gap: clamp(var(--space-4), 3vw, 44px);
  }

  .dx__item {
    position: relative;
    border-bottom: 1px solid var(--color-line);
  }

  .dx__item:last-child {
    border-bottom: 0;
  }

  /* Soft panel behind the open row */
  .dx__item::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--space-3) * -1);
    z-index: 0;
    border-radius: 14px;
    background: var(--color-surface);
    opacity: 0;
    transform: scaleY(0.92);
    transition:
      opacity 400ms var(--ease-out),
      transform 500ms var(--ease-out);
    pointer-events: none;
  }

  .dx__item.is-open::before {
    opacity: 1;
    transform: none;
  }

  .dx__heading {
    position: relative;
    z-index: 1;
    margin: 0;
  }

  .dx__trigger {
    display: flex;
    align-items: baseline;
    gap: var(--row-gap);
    width: 100%;
    padding: clamp(var(--space-3), 1.4vw, 22px) 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
  }

  .dx__num {
    flex: none;
    width: 1ch;
    font-size: var(--row-size);
    font-weight: var(--fw-medium);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, var(--color-ink) 22%, transparent);
    transition: color 350ms var(--ease-out);
  }

  .dx__name {
    font-size: var(--row-size);
    font-weight: var(--fw-semibold);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--color-text-muted);
    transition:
      color 350ms var(--ease-out),
      transform 450ms var(--ease-out);
  }

  .dx__item.is-open .dx__name {
    color: var(--color-ink);
    transform: translate3d(8px, 0, 0);
  }

  .dx__item.is-open .dx__num {
    color: var(--color-brand);
  }

  .dx__trigger:focus-visible {
    outline: none;
  }

  .dx__trigger:focus-visible .dx__name {
    text-decoration: underline;
    text-decoration-color: var(--color-brand);
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }

  /* Capabilities unfold under the name */
  .dx__body {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 500ms var(--ease-out);
  }

  .dx__item.is-open .dx__body {
    grid-template-rows: 1fr;
  }

  .dx__body-inner {
    min-height: 0;
    overflow: hidden;
  }

  .dx__covers {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    /* line up under the name: digit width (~0.6em of the row size) + gap + the 8px nudge */
    padding: 0 0 clamp(var(--space-4), 1.6vw, 24px) calc(var(--row-size) * 0.6 + var(--row-gap) + 8px);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    letter-spacing: 0.04em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--color-text);
    opacity: 0;
    transform: translate3d(0, -6px, 0);
    transition:
      opacity 250ms var(--ease-out),
      transform 250ms var(--ease-out);
  }

  .dx__item.is-open .dx__covers {
    opacity: 1;
    transform: none;
    transition:
      opacity 400ms var(--ease-out) 120ms,
      transform 400ms var(--ease-out) 120ms;
  }

  .dx__covers li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .dx__covers li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand);
  }

  /* Phones: tighter rows, tags indented less */
  @media (max-width: 599px) {
    .dx__item::before {
      inset: 0 calc(var(--space-2) * -1);
      border-radius: 10px;
    }

    .dx__covers {
      padding-left: 0;
      gap: var(--space-2) var(--space-4);
    }
  }
</style>
