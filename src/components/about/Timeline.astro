---
/**
 * Journey timeline, 2019 → 2026.
 *
 * Port of the Framer "ScrollTimeline" code component (framer.com/m/Scrolltimeline-INOzsL.js)
 * to plain Astro + DOM, no React needed: a sticky rounded frame holds one full-size panel per
 * milestone; scroll wipes each panel off to the left (clip-path) while its big year tips over
 * (rotate -90° from the bottom-left corner) and the next panel wipes in from the right.
 *
 * Additions for this page: section heading, progress line, keyboard year scrubber with
 * aria-current, brand panel themes, and the 2026 capability-chip finale.
 *
 * Modes:
 * - Pinned (≥ 768px, motion allowed, JS): the wipe described above.
 * - Stacked (< 768px, reduced motion, or no JS): panels become stacked cards that reveal on scroll.
 */
import { timeline } from '../../data/about.js';

const { eyebrow, title, intro, milestones } = timeline;
---

<section class="tl section" id="journey" aria-labelledby="journey-title">
  <header class="container tl__head">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="section-title" id="journey-title">{title}</h2>
    <p class="tl__intro">{intro}</p>
  </header>

  <div class="tl__track" data-timeline style={`--count: ${milestones.length}`}>
    <div class="tl__frame" data-tl-frame data-tone={milestones[0].theme}>
      <div class="tl__progress" aria-hidden="true">
        <span class="tl__progress-fill" data-tl-fill></span>
      </div>

      <ol class="tl__panels">
        {
          milestones.map((m, i) => (
            <li
              class:list={['tl__panel', `tl__panel--${m.theme}`, { 'is-finale': m.finale }]}
              id={`tl-item-${i}`}
              data-tl-panel={i}
              data-theme-name={m.theme}
              data-reveal
            >
              <article class="tl__inner">
                <div class="tl__header">
                  <h3 class="tl__label">
                    <span class="tl__index" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}/
                    </span>
                    {m.phase}
                    {m.badge && <span class="tl__badge">{m.badge}</span>}
                  </h3>
                  <p class="tl__desc">{m.text}</p>
                  {m.chips && (
                    <ul class="tl__chips" aria-label="New capability areas in 2026">
                      {m.chips.map((chip, c) => (
                        <li class="tl__chip" style={`--i: ${c}`}>
                          {chip}
                        </li>
                      ))}
                    </ul>
                  )}
                  {m.principle && (
                    <p class="tl__principle">
                      <span class="tl__principle-label">{m.principle.label}</span>
                      <span>{m.principle.text}</span>
                    </p>
                  )}
                </div>
                <p class:list={['tl__year', { 'tl__year--long': m.year.length > 4 }]} data-tl-year>
                  <span class="visually-hidden">Year: </span>
                  {m.year}
                </p>
              </article>
            </li>
          ))
        }
      </ol>

      <nav class="tl__scrubber" aria-label="Jump to a year">
        <ol>
          {
            milestones.map((m, i) => (
              <li>
                <button
                  class="tl__year-btn"
                  type="button"
                  data-tl-btn={i}
                  tabindex={i === 0 ? 0 : -1}
                  aria-controls={`tl-item-${i}`}
                >
                  <span class="tl__dot" aria-hidden="true" />
                  <span class="tl__year-label">{m.year}</span>
                  <span class="visually-hidden">: {m.phase}</span>
                </button>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </div>
</section>

<script>
  const wide = window.matchMedia('(min-width: 768px)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-timeline]').forEach((track) => {
    const frame = track.querySelector<HTMLElement>('[data-tl-frame]')!;
    const panels = [...track.querySelectorAll<HTMLElement>('[data-tl-panel]')];
    const years = panels.map((p) => p.querySelector<HTMLElement>('[data-tl-year]'));
    const buttons = [...track.querySelectorAll<HTMLButtonElement>('[data-tl-btn]')];
    const fill = track.querySelector<HTMLElement>('[data-tl-fill]');
    const n = panels.length;
    let pinned = false;
    let active = -1;
    let queued = false;

    const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));

    /** Same panel maths as the Framer component: `scaled` runs 0 → n-1. */
    function applyAt(scaled: number) {
      const s = clamp(scaled, 0, n - 1);
      const idx = Math.min(n - 2, Math.floor(s));
      const t = s - idx;
      panels.forEach((panel, i) => {
        const year = years[i];
        if (i < idx) {
          panel.style.clipPath = 'inset(0 0 0 100%)';
          if (year) year.style.transform = 'rotate(-90deg)';
        } else if (i === idx) {
          panel.style.clipPath = `inset(0 ${t * 100}% 0 0)`;
          if (year) year.style.transform = `rotate(${-90 * t}deg)`;
        } else if (i === idx + 1) {
          panel.style.clipPath = `inset(0 0 0 ${(1 - t) * 100}%)`;
          if (year) year.style.transform = 'rotate(0deg)';
        } else {
          panel.style.clipPath = 'inset(0 0 0 100%)';
          if (year) year.style.transform = 'rotate(0deg)';
        }
        panel.style.zIndex = String(i);
      });
    }

    function clearInline() {
      panels.forEach((panel, i) => {
        panel.style.clipPath = '';
        panel.style.zIndex = '';
        const year = years[i];
        if (year) year.style.transform = '';
      });
      if (fill) fill.style.transform = '';
    }

    function setActive(i: number) {
      if (i === active) return;
      active = i;
      frame.dataset.tone = panels[i].dataset.themeName;
      panels.forEach((el, k) => {
        el.classList.toggle('is-active', k === i);
        if (k === i) el.setAttribute('aria-current', 'step');
        else el.removeAttribute('aria-current');
      });
      buttons.forEach((btn, k) => {
        btn.classList.toggle('is-active', k === i);
        btn.classList.toggle('is-past', k < i);
        btn.tabIndex = k === i ? 0 : -1;
        if (k === i) btn.setAttribute('aria-current', 'step');
        else btn.removeAttribute('aria-current');
      });
    }

    function progress() {
      const rect = track.getBoundingClientRect();
      const total = track.offsetHeight - window.innerHeight;
      return total > 0 ? clamp(-rect.top / total, 0, 1) : 0;
    }

    function update() {
      queued = false;
      if (!pinned) return;
      const raw = progress();
      const scaled = raw * (n - 1);
      if (fill) fill.style.transform = `scaleX(${raw})`;
      applyAt(scaled);
      setActive(clamp(Math.round(scaled), 0, n - 1));
    }

    function onScroll() {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    }

    /** Panel i is fully shown when scaled === i. */
    function scrollToIndex(i: number) {
      const top = track.getBoundingClientRect().top + window.scrollY;
      const total = track.offsetHeight - window.innerHeight;
      window.scrollTo({ top: top + (i / (n - 1)) * total, behavior: reduce.matches ? 'auto' : 'smooth' });
    }

    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        setActive(i);
        scrollToIndex(i);
      });
      btn.addEventListener('keydown', (e) => {
        let next = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = Math.min(n - 1, i + 1);
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = Math.max(0, i - 1);
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = n - 1;
        if (next < 0) return;
        e.preventDefault();
        setActive(next);
        buttons[next].focus({ preventScroll: true });
        scrollToIndex(next);
      });
    });

    function applyMode() {
      const wasPinned = pinned;
      pinned = wide.matches && !reduce.matches;
      track.classList.toggle('is-pinned', pinned);
      panels.forEach((el) => {
        if (pinned) {
          // The wipe owns panel visibility; the generic scroll reveal is switched off.
          el.removeAttribute('data-reveal');
          el.classList.add('is-visible');
        } else if (wasPinned) {
          el.setAttribute('data-reveal', '');
        }
      });
      if (!pinned) {
        clearInline();
        panels.forEach((el) => {
          el.classList.remove('is-active');
          el.removeAttribute('aria-current');
        });
        active = -1;
        return;
      }
      active = -1;
      update();
    }

    // Listen to scroll only while the track is near the viewport.
    let listening = false;
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !listening) {
          window.addEventListener('scroll', onScroll, { passive: true });
          listening = true;
        } else if (!entry.isIntersecting && listening) {
          window.removeEventListener('scroll', onScroll);
          listening = false;
        }
        update();
      },
      { rootMargin: '100px 0px' },
    ).observe(track);

    wide.addEventListener('change', applyMode);
    reduce.addEventListener('change', applyMode);
    window.addEventListener('resize', onScroll, { passive: true });
    applyMode();
  });
</script>

<style>
  /* ---------- Section head ---------- */
  .tl__head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: clamp(var(--space-6), 4vw, var(--space-7));
  }

  .tl__intro {
    max-width: 34rem;
    font-size: var(--fs-lead);
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }

  /* ---------- Panel themes (brand tokens) ---------- */
  .tl__panel--light {
    --panel-bg: var(--color-surface);
    --panel-fg: var(--color-ink);
    --panel-accent: var(--color-brand);
    --panel-soft: var(--color-text-muted);
    --panel-line: var(--color-line);
  }

  .tl__panel--dark {
    --panel-bg: var(--color-ink);
    --panel-fg: var(--color-on-brand);
    --panel-accent: var(--color-on-brand);
    --panel-soft: rgb(255 255 255 / 0.7);
    --panel-line: rgb(255 255 255 / 0.2);
  }

  .tl__panel--brand {
    --panel-bg: var(--color-brand);
    --panel-fg: var(--color-on-brand);
    --panel-accent: var(--color-on-brand);
    --panel-soft: rgb(255 255 255 / 0.85);
    --panel-line: rgb(255 255 255 / 0.3);
  }

  /* ---------- Panels: stacked cards by default (mobile, reduced motion, no JS) ---------- */
  .tl__track {
    padding-inline: var(--gutter);
  }

  .tl__frame {
    max-width: var(--container);
    margin-inline: auto;
  }

  .tl__progress,
  .tl__scrubber {
    display: none;
  }

  .tl__panels {
    display: grid;
    gap: var(--space-3);
  }

  .tl__panel {
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--panel-bg);
    color: var(--panel-fg);
  }

  .tl__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
    height: 100%;
    padding: var(--space-5);
  }

  .tl__header {
    display: grid;
    gap: var(--space-3);
    max-width: 30rem;
  }

  .tl__label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-eyebrow);
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--panel-soft);
  }

  .tl__index {
    color: var(--panel-accent);
  }

  .tl__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-brand);
    font-size: 0.6875rem;
  }

  .tl__badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    animation: tl-blink 1.6s var(--ease-in-out) infinite;
  }

  .tl__desc {
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    line-height: 1.55;
  }

  .tl__principle {
    display: grid;
    gap: var(--space-1);
    padding-top: var(--space-3);
    border-top: 1px solid var(--panel-line);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
  }

  .tl__principle-label {
    font-size: 0.6875rem;
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--panel-soft);
  }

  .tl__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tl__chip {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-brand);
    font-size: 0.8125rem;
    font-weight: var(--fw-semibold);
    line-height: 1.2;
  }

  .tl__year {
    margin: 0;
    font-size: clamp(4rem, 2.5rem + 9vw, 7rem);
    font-weight: 800;
    line-height: 0.78;
    letter-spacing: -0.045em;
    white-space: nowrap;
    color: var(--panel-fg);
    transform-origin: left bottom;
  }

  /* Ranges like "2020–21" are wider; keep them inside a 360px card */
  .tl__year--long {
    font-size: clamp(3.25rem, 1rem + 12vw, 7rem);
  }

  /* Finale: chips burst in once the 2026 panel is shown */
  .js .tl__panel.is-finale .tl__chip {
    opacity: 0;
    transform: translate3d(0, 12px, 0) scale(0.85);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: calc(200ms + var(--i) * 90ms);
  }

  .js .tl__track:not(.is-pinned) .tl__panel.is-finale.is-visible .tl__chip,
  .js .tl__track.is-pinned .tl__panel.is-finale.is-active .tl__chip {
    opacity: 1;
    transform: none;
  }

  /* ---------- Pinned mode: the Framer ScrollTimeline layout ---------- */
  .tl__track.is-pinned {
    height: calc(var(--count) * 100vh);
    padding-inline: 0;
  }

  .tl__track.is-pinned .tl__frame {
    --inset: var(--space-5); /* 24px, Framer "Frame Inset" */
    position: sticky;
    top: var(--inset);
    height: calc(100vh - var(--inset) * 2);
    height: calc(100svh - var(--inset) * 2);
    max-width: none;
    margin: 0 var(--inset);
    overflow: hidden;
    border-radius: 28px; /* Framer "Corner Radius" */
    background: var(--color-ink);
  }

  .tl__track.is-pinned .tl__panels {
    display: block;
    height: 100%;
  }

  .tl__track.is-pinned .tl__panel {
    position: absolute;
    inset: 0;
    border-radius: 0;
    clip-path: inset(0 0 0 100%);
    will-change: clip-path;
  }

  .tl__track.is-pinned .tl__inner {
    padding: clamp(var(--space-6), 3.5vw, 48px);
    padding-top: calc(clamp(var(--space-6), 3.5vw, 48px) + var(--space-5));
  }

  .tl__track.is-pinned .tl__header {
    align-self: flex-end;
    max-width: 440px;
  }

  .tl__track.is-pinned .tl__desc {
    font-size: var(--fs-lead);
  }

  .tl__track.is-pinned .tl__year {
    font-size: clamp(6rem, 1rem + 13vw, 13.5rem); /* Framer "Big Text" 216px */
    will-change: transform;
    margin-bottom: clamp(var(--space-7), 6vh, 72px);
  }

  /* Progress line across the top of the frame */
  .tl__track.is-pinned .tl__progress {
    position: absolute;
    top: var(--space-5);
    left: clamp(var(--space-6), 3.5vw, 48px);
    right: clamp(var(--space-6), 3.5vw, 48px);
    z-index: 30;
    display: block;
    height: 2px;
    border-radius: 2px;
    overflow: hidden;
    background: color-mix(in srgb, currentColor 22%, transparent);
  }

  .tl__progress-fill {
    position: absolute;
    inset: 0;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
  }

  /* Scrubber, top-left of the frame; follows the active panel's colours */
  .tl__frame[data-tone='light'] {
    --tone-fg: var(--color-ink);
    --tone-accent: var(--color-brand);
    --tone-soft: var(--color-text-muted);
  }

  .tl__frame[data-tone='dark'],
  .tl__frame[data-tone='brand'] {
    --tone-fg: var(--color-on-brand);
    --tone-accent: var(--color-on-brand);
    --tone-soft: rgb(255 255 255 / 0.72);
  }

  .tl__track.is-pinned .tl__frame {
    color: var(--tone-fg);
  }

  .tl__track.is-pinned .tl__scrubber {
    position: absolute;
    top: calc(clamp(var(--space-6), 3.5vw, 48px) + var(--space-4));
    left: calc(clamp(var(--space-6), 3.5vw, 48px) - 8px);
    z-index: 30;
    display: block;
  }

  .tl__scrubber ol {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .tl__year-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 6px 8px;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--tone-soft);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .tl__year-btn:hover,
  .tl__year-btn.is-active {
    color: var(--tone-fg);
  }

  .tl__year-btn:focus-visible {
    outline: 2px solid var(--tone-fg);
    outline-offset: 0;
  }

  .tl__dot {
    position: relative;
    width: 8px;
    height: 8px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .tl__dot::before,
  .tl__dot::after {
    content: '';
    position: absolute;
    inset: -1.5px;
    border-radius: 50%;
    background: var(--tone-accent);
    opacity: 0;
    transform: scale(0.3);
    transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }

  .tl__year-btn.is-past .tl__dot::before,
  .tl__year-btn.is-active .tl__dot::before {
    opacity: 1;
    transform: scale(1);
  }

  .tl__year-btn.is-active .tl__dot {
    transform: scale(1.3);
  }

  .tl__year-btn.is-active .tl__dot::after {
    animation: tl-pulse 1.8s var(--ease-out) infinite;
  }

  .tl__year-label {
    transform-origin: left center;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .tl__year-btn.is-active .tl__year-label {
    transform: scale(1.15);
  }

  @keyframes tl-pulse {
    0% {
      opacity: 0.5;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(2.8);
    }
  }

  @keyframes tl-blink {
    50% {
      opacity: 0.3;
    }
  }

  @media (min-width: 768px) {
    .tl__panels {
      gap: var(--space-4);
    }

    .tl__inner {
      padding: var(--space-6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tl__badge::before,
    .tl__year-btn.is-active .tl__dot::after {
      animation: none;
    }
  }
</style>
