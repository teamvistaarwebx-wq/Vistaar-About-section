---
import { founder } from '../../data/about.js';
import PersonPlaceholder from './PersonPlaceholder.astro';
---

<section class="section founder" aria-labelledby="founder-title">
  <div class="container founder__grid">
    <figure class="founder__media" data-reveal>
      {
        founder.photo ? (
          <img
            src={founder.photo}
            alt={`${founder.name}, ${founder.role} of Vistaar WebX`}
            width="480"
            height="528"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <PersonPlaceholder name={founder.name} />
        )
      }
      <figcaption class="founder__caption">
        <span class="founder__name">{founder.name}</span>
        <span class="founder__role">{founder.role}</span>
      </figcaption>
    </figure>

    <div class="founder__body">
      <p class="eyebrow">{founder.eyebrow}</p>
      <h2 class="section-title" id="founder-title" data-reveal>
        {founder.name}, <span class="accent">{founder.role}</span>
      </h2>
      <div class="founder__story" data-reveal>
        {founder.story.map((para) => <p>{para}</p>)}
      </div>

      <figure class="founder__quote" data-reveal>
        <blockquote>
          <p>{founder.quote}</p>
        </blockquote>
        <figcaption>{founder.quoteLabel}</figcaption>
      </figure>
    </div>

    <div class="founder__base" data-reveal>
      <h3 class="founder__base-title">{founder.base.title}</h3>
      <p class="founder__base-text">{founder.base.text}</p>
      <ul class="founder__markets" aria-label="Markets we stay close to">
        {founder.base.markets.map((m) => <li class="chip">{m}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .founder__grid {
    display: grid;
    gap: var(--space-7);
  }

  .founder__media {
    position: relative;
    align-self: start;
    overflow: hidden;
    max-width: 440px;
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .founder__media img {
    width: 100%;
    aspect-ratio: 10 / 11;
    object-fit: cover;
  }

  .founder__caption {
    display: grid;
    gap: 2px;
    padding: var(--space-4) var(--space-5);
    background: var(--color-brand);
    color: var(--color-on-brand);
  }

  .founder__name {
    font-size: var(--fs-card-title);
    font-weight: var(--fw-bold);
  }

  .founder__role {
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
  }

  .founder__body {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .founder__story {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
    font-size: var(--fs-lead);
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }

  .founder__quote {
    position: relative;
    max-width: 44rem;
    margin-top: var(--space-4);
    padding: var(--space-6) var(--space-6) var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-brand);
    color: var(--color-on-brand);
  }

  .founder__quote::before {
    content: '“';
    position: absolute;
    top: -0.2em;
    left: var(--space-5);
    font-size: 6rem;
    font-weight: var(--fw-bold);
    line-height: 1;
    opacity: 0.35;
  }

  .founder__quote blockquote {
    margin: 0;
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    text-wrap: balance;
  }

  .founder__quote figcaption {
    margin-top: var(--space-4);
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .founder__base {
    display: grid;
    gap: var(--space-3);
    padding: clamp(var(--space-5), 4vw, var(--space-7));
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .founder__base-title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
  }

  .founder__base-text {
    max-width: 40rem;
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }

  .founder__markets {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  @media (min-width: 768px) {
    .founder__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--space-7);
    }

    .founder__base {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .founder__grid {
      column-gap: clamp(var(--space-7), 6vw, 120px);
    }
  }
</style>
